# Base de datos
DATABASE_URL=postgresql://usuario:password@host:5432/mercanto

# Autenticación — genera un valor seguro con: openssl rand -base64 32
JWT_SECRET=

# Frontend (URL donde corre el frontend para CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Límites
MAX_PRODUCTS_PER_STORE=30

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Mercanto <noreply@mercanto.pe>

# Cron jobs
CRON_SECRET=

# Entorno
NODE_ENV=development
